# Copy this file to .env.local and fill values from each provider dashboard.
# Do not commit .env.local or real secrets.

# Adsterra trust and revenue verification
# Example format: adsterra.com, 123456, DIRECT
ADSTERRA_ADS_TXT_SELLER_LINE=
ADSTERRA_API_KEY=

# Required active Adsterra units
NEXT_PUBLIC_ADSTERRA_TOP_KEY=
NEXT_PUBLIC_ADSTERRA_SIDEBAR_KEY=
NEXT_PUBLIC_ADSTERRA_NATIVE_SCRIPT=
NEXT_PUBLIC_ADSTERRA_NATIVE_KEY=

# High-impact Adsterra experiments
NEXT_PUBLIC_ADSTERRA_DIRECT_LINK_URL=
NEXT_PUBLIC_ADSTERRA_DIRECT_LINK_SUB_ID_PARAM=psid
NEXT_PUBLIC_ADSTERRA_MOBILE_RECTANGLE_KEY=
NEXT_PUBLIC_ADSTERRA_MOBILE_STICKY_KEY=
NEXT_PUBLIC_ADSTERRA_MOBILE_STICKY_WIDTH=320
NEXT_PUBLIC_ADSTERRA_MOBILE_STICKY_HEIGHT=50
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_SCRIPT=
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_DELAY_MS=15000
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_SESSION_CAP=true

# Dedicated Adsterra placement keys for clean RPM reporting
NEXT_PUBLIC_ADSTERRA_HOME_INLINE_KEY=
NEXT_PUBLIC_ADSTERRA_TOOL_TOP_KEY=
NEXT_PUBLIC_ADSTERRA_TOOL_MID_KEY=
NEXT_PUBLIC_ADSTERRA_TOOL_BOTTOM_KEY=
NEXT_PUBLIC_ADSTERRA_SIDEBAR_SECONDARY_KEY=
NEXT_PUBLIC_ADSTERRA_TOOLS_INDEX_TOP_KEY=
NEXT_PUBLIC_ADSTERRA_TOOLS_INDEX_BOTTOM_KEY=
NEXT_PUBLIC_ADSTERRA_BLOG_TOP_KEY=
NEXT_PUBLIC_ADSTERRA_BLOG_BOTTOM_KEY=
NEXT_PUBLIC_ADSTERRA_BLOG_ARTICLE_TOP_KEY=
NEXT_PUBLIC_ADSTERRA_BLOG_ARTICLE_MID_KEY=
NEXT_PUBLIC_ADSTERRA_BLOG_ARTICLE_BOTTOM_KEY=
NEXT_PUBLIC_ADSTERRA_BLOG_ARTICLE_SIDEBAR_KEY=
NEXT_PUBLIC_ADSTERRA_CATEGORY_TOP_KEY=
NEXT_PUBLIC_ADSTERRA_CATEGORY_BOTTOM_KEY=

# Optional support/sponsor/affiliate links
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_SPONSOR_CONTACT_URL=
